# Neon pooled connection for application traffic. Keep server-only.
DATABASE_URL=
# Neon direct connection for schema migration commands, if available.
DATABASE_URL_UNPOOLED=
# Used only by scripts/tutor:setup.mjs; remove after provisioning.
TUTOR_EMAIL=
TUTOR_INITIAL_PASSWORD=
TUTOR_DISPLAY_NAME=
# Server-only. Enables the photo-to-quiz generator at /quiz. Optional ANTHROPIC_MODEL overrides the default model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Password reset on /login/forgot. Use either or both.
# Recovery key: a long random secret (16+ characters).
PASSWORD_RESET_KEY=
# Emailed link via Resend.
RESEND_API_KEY=
RESET_EMAIL_FROM=
# Optional: always send the link to this inbox instead of the tutor login email.
RESET_EMAIL_TO=
# Optional: site address used in the emailed link. Defaults to the Vercel production URL.
APP_URL=
